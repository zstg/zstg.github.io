---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugMap } from '../../lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

  return tags.map((tag) => {
    const matching = posts
      .filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag },
      props: { tag, posts: matching, slugs: slugMap(matching.map((p) => p.id)) },
    };
  });
}

const { tag, posts, slugs } = Astro.props;
---

<BaseLayout title={`${tag} — zstg`}>
  <section data-pagefind-ignore class="max-w-4xl mx-auto px-6 pt-24 pb-20 relative z-10">
    <a href="/tags" class="text-sm text-muted hover:text-accent transition-colors">
      ← all tags
    </a>

    <h1 class="text-3xl font-bold text-light mt-4 mb-2">{tag}</h1>
    <p class="text-sm text-muted mb-10">
      {posts.length} post{posts.length === 1 ? '' : 's'} tagged {tag}
    </p>

    <div class="space-y-6">
      {posts.map((post) => (
        <a
          href={`/blog/${slugs.get(post.id)}`}
          class="block glass-card border border-white/10 rounded-xl p-5 hover:border-accent/40 transition-all duration-300 group"
        >
          <time
            datetime={post.data.date.toISOString()}
            class="block text-sm text-muted mb-2"
          >
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </time>
          <h2 class="text-light font-semibold text-lg group-hover:text-accent transition-colors">
            {post.data.title}
          </h2>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
