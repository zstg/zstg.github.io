      <ul class="flex items-center gap-1">
        <li><a href="/" class="px-3 py-1.5 text-sm text-muted">Home</a></li>
        <li><a href="/blog" class="px-3 py-1.5 text-sm text-muted">Blog</a></li>
        <li><a href="/about" class="px-3 py-1.5 text-sm text-muted">About</a></li>
        <li><a href="/resume" class="px-3 py-1.5 text-sm text-muted">Resume</a></li>
