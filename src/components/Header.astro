---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
];

const currentPath = Astro.url.pathname;
---
<header class="fixed top-0 left-0 right-0 z-50 bg-dark/80 backdrop-blur-md border-b border-white/5">
  <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="text-accent font-semibold tracking-tight hover:text-light transition-colors">
      zstg
    </a>
    <ul class="flex items-center gap-1">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'px-3 py-1.5 rounded-lg text-sm transition-all duration-300',
              currentPath === href || (href !== '/' && currentPath.startsWith(href))
                ? 'text-accent bg-accent/10'
                : 'text-muted hover:text-accent hover:bg-accent/5',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
