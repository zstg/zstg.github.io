---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ParticleSphere from '../components/ParticleSphere';
import RocketCursor from '../components/RocketCursor';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'zstg — personal site',
  description = 'Personal website and blog',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Thunderman.ttf" as="font" type="font/ttf" crossorigin />
    <ClientRouter />
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem('wob-theme-v1') || '{"theme":"midnight"}');
        var el = document.documentElement;
        var id = s.theme || 'midnight';
        el.dataset.theme = id;
        if (id === 'custom' && s.customAccent) {
          var c = s.customAccent;
          var n = (c.match(/[\d.]+/g) || []).map(Number);
          var l = n.length >= 3 ? n[2] : 0.6;          // canonical hsla: h, s, l, a
          var a = n.length >= 4 ? n[3] : 1;
          el.style.setProperty('--color-accent', c);
          el.style.setProperty('--color-accent-dim', 'color-mix(in srgb, ' + c + ' 68%, #050508)');
          el.style.setProperty('--color-on-accent', (l > 0.42 && a > 0.35) ? '#0a0a12' : '#f2f6ff');
        }
      } catch (e) { document.documentElement.dataset.theme = 'midnight'; }
    </script>
  </head>
  <body class="min-h-screen relative">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <ParticleSphere client:visible span={0.8} />
    </div>
    <RocketCursor client:load />
    <Header />
    <main class="w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
