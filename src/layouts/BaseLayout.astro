---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ParticleSphere from '../components/ParticleSphere';
import BackgroundFX from '../components/BackgroundFX';
import RocketCursor from '../components/RocketCursor';
import ReadProgress from '../components/ReadProgress';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'zstg — personal site',
  description = 'Personal website and blog',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Thunderman.ttf" as="font" type="font/ttf" crossorigin />
    <ClientRouter />
    <!--
      Restore the stored theme onto <html> before the first paint, and again at
      the start of every client-side navigation (data-astro-rerun).

      Both are needed. Astro's swap calls swapRootAttributes(), which *removes
      every attribute* from the live <html> and copies the incoming document's -
      and that document is server-rendered, so it carries no data-theme and no
      inline custom-accent variables. Astro also refuses to re-run an inline
      script it has already run unless the script opts in. Without both of
      these the theme was restored exactly once, on the first full load: every
      page reached by a client-side navigation came up on the :root defaults
      (and, for a custom accent, lost its colour entirely) while the picker
      still showed the theme that had been chosen.

      src/lib/theme-boot.ts re-asserts both preferences on Astro's navigation
      events as a backstop, so the theme does not depend on this one attribute
      continuing to behave as documented.
    -->
    <script is:inline data-astro-rerun>
      try {
        var s = JSON.parse(localStorage.getItem('wob-theme-v1') || '{"theme":"matrix"}');
        var el = document.documentElement;
        var id = s.theme || 'matrix';
        el.dataset.theme = id;
        if (id === 'custom' && s.customAccent) {
          var c = s.customAccent;
          el.style.setProperty('--color-accent', c);
          el.style.setProperty('--color-accent-dim', 'color-mix(in srgb, ' + c + ' 68%, #050508)');
          // canonical accent is hex (#rrggbb / #rrggbbaa); pick readable text
          var hm = c.replace('#', '');
          var r = parseInt(hm.slice(0, 2), 16) / 255;
          var g = parseInt(hm.slice(2, 4), 16) / 255;
          var b = parseInt(hm.slice(4, 6), 16) / 255;
          var a = hm.length >= 8 ? parseInt(hm.slice(6, 8), 16) / 255 : 1;
          var lin = function (u) { return u <= 0.03928 ? u / 12.92 : Math.pow((u + 0.055) / 1.055, 2.4); };
          var lum = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
          el.style.setProperty('--color-on-accent', (lum > 0.42 && a > 0.35) ? '#0a0a12' : '#f2f6ff');
        }
      } catch (e) { document.documentElement.dataset.theme = 'matrix'; }
    </script>
    <!--
      Bundled, so it runs once per full load and stays registered for the whole
      session: it re-asserts the stored theme and background around every
      client-side navigation, which is what keeps a single choice applying to
      every page. See src/lib/theme-boot.ts.
    -->
    <script>
      import '../lib/theme-boot';
    </script>
  </head>
  <body class="min-h-screen relative">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <BackgroundFX client:load />
      <ParticleSphere client:visible peak={0.25} />
    </div>
    <RocketCursor client:load />
    <ReadProgress client:load />
    <Header />
    <!--
      data-pagefind-body scopes the search index to the page's content.
      Without it Pagefind indexes the whole document, which drags the header
      island's theme/background option lists into every excerpt.
    -->
    <main class="w-full" data-pagefind-body>
      <slot />
    </main>
    <Footer>
      {/* pages can drop something into the dock's middle slot */}
      <slot name="dock" slot="dock" />
    </Footer>
    <script is:inline>
      /*
       * Material-You ripple. A pointer-down spawns a scaling span inside the
       * pressed button. Guarded so the listener is only ever registered once,
       * even across view-transition navigations.
       */
      if (!window.__wobRipple) {
        window.__wobRipple = true;
        var M3 = '.btn, .btn-tonal, .btn-outlined, .btn-ghost, .m3-btn';
        document.addEventListener(
          'pointerdown',
          function (e) {
            var el = e.target && e.target.closest ? e.target.closest(M3) : null;
            if (!el) return;
            var r = el.getBoundingClientRect();
            var d = Math.max(r.width, r.height) * 1.4;
            var s = document.createElement('span');
            s.className = 'ripple';
            s.style.width = d + 'px';
            s.style.height = d + 'px';
            s.style.left = e.clientX - r.left - d / 2 + 'px';
            s.style.top = e.clientY - r.top - d / 2 + 'px';
            el.appendChild(s);
            s.addEventListener('animationend', function () {
              s.remove();
            });
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
